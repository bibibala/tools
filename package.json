{
  "name": "codeforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "prepare": "simple-git-hooks",
    "postinstall": "git add --renormalize . || true"
  },
  "dependencies": {
    "html2pdf.js": "^0.14.0",
    "shiki": "^4.4.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@bilibaba/ts-lab": "^1.0.5",
    "@eslint/js": "^10.0.1",
    "@unhead/vue": "2.1.16",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "~10.11.0",
    "globals": "^17.12.0",
    "jszip": "^3.10.2",
    "lint-staged": "^17.5.1",
    "lunar-javascript": "^1.7.7",
    "prettier": "3.9.6",
    "simple-git-hooks": "^2.14.0",
    "vite": "^8.3.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-ssg": "^28.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "post-merge": "pnpm prepare"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write --end-of-line lf"
    ],
    "*.{json,scss,html,md}": [
      "prettier --write --end-of-line lf"
    ]
  }
}
